[alias]
  aa = add -A
  b = branch
  ba = branch --all
  bd = branch --delete
  br = branch --remote
  c = commit -v
  ca = commit -v --amend
  cane = commit -v --amend --no-edit
  cl = clone
  cm = commit -m
  co = checkout
  cob = checkout -b
  d = diff
  ds = diff --staged
  fap = fetch --all --prune
  lg = log --graph
  lga = log --graph --decorate --all
  lgo = log --graph --oneline --decorate
  lgoa = log --graph --oneline --decorate --all
  lo = log --oneline --decorate
  ls = log --stat --paginate
  p = push
  pf = push --force
  st = status

[branch]
  autosetuprebase = always

[color]
  ui = true

[commit]
  verbose = true

[core]
  autocrlf = input
  pager = delta

[diff]
  algorithm = histogram
  colorMoved = plain

[difftool]
  prompt = false
  trustExitCode = true

[fetch]
  parallel = 0

[init]
  defaultBranch = main

[interactive]
  diffFilter = delta --color-only

[merge]
  conflictstyle = zdiff3

[pull]
  rebase = true

[push]
  autoSetupRemote = true
  default = current
  followTags = true

[rebase]
  autostash = true

[safe]
	directory = ~/work/*

[user]
  email = hermitmaster@icloud.com
  name = Dennis Rausch

[includeIf "gitdir:~/work/"]
  path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:https://github.com/PFPT-*/**"]
  path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:https://github.com/drausch_pfpt/**"]
  path = ~/.gitconfig-work
[includeIf "hasconfig:remote.*.url:https://proofpoint.github.com/**"]
  path = ~/.gitconfig-work

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
